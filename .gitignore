# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Agent instructions that `next dev` writes and re-writes for itself. Their
# contents describe the installed Next.js version, not this project, so they
# would churn on every upgrade. The project's own entry point is AGENTS.md at
# the repo root, which is committed. Leave these generated — they are useful
# locally — just not tracked.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Local data
.rudder-dev/

# Environment / secrets
.env
.env.local
.env.*.local

# Local databases
*.sqlite
*.sqlite3
*.db

# Integration test scratch — bot working directories must live on a path the
# container runtime shares, so they cannot go in the OS temp dir.
.rudder-test/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Freqtrade lab artifacts — regenerable, large, or credential-bearing.
# config.example.json is committed; the real config.json is not.
ft_lab/user_data/config.json
ft_lab/user_data/data/
ft_lab/user_data/backtest_results/
ft_lab/user_data/logs/
ft_lab/user_data/plot/
ft_lab/user_data/hyperopt_results/

# Freqtrade's own scaffolding — not ours to vendor.
