{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptobot.local/schema/ruleset.schema.json",
  "title": "Strategy Ruleset",
  "description": "Bir alım-satım stratejisinin çalıştırılabilir kod yerine yapısal veri olarak tanımı. Bu şema aynı zamanda güvenlik sınırıdır: şemayı geçen hiçbir kural seti kod çalıştıramaz.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "timeframe", "indicators", "entry", "risk"],

  "properties": {
    "schema_version": { "const": 1 },

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "description": "Kalıcı benzersiz kimlik. Fork edildiğinde yeni id üretilir."
    },

    "name": {
      "$ref": "#/$defs/localizedText",
      "description": "Yazarın verdiği görünen ad. Açıklama metni yazardan alınmaz, kural setinden üretilir."
    },

    "timeframe": {
      "enum": ["1m", "5m", "15m", "30m", "1h", "2h", "4h", "6h", "12h", "1d"]
    },

    "indicators": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/indicator" },
      "description": "Kullanılacak indikatörler. Yalnızca whitelist'teki fonksiyonlar."
    },

    "entry": { "$ref": "#/$defs/condition" },
    "exit": { "$ref": "#/$defs/condition" },

    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stoploss"],
      "properties": {
        "stoploss": {
          "type": "number",
          "exclusiveMaximum": 0,
          "minimum": -0.99,
          "description": "Negatif oran. -0.05 = %5 zarar kes."
        },
        "roi": {
          "type": "object",
          "description": "Dakika (string) -> kâr oranı. \"0\" anahtarı zorunlu.",
          "required": ["0"],
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "trailing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "positive": { "type": "number", "exclusiveMinimum": 0 },
            "positive_offset": { "type": "number", "minimum": 0 },
            "only_offset_is_reached": { "type": "boolean" }
          }
        }
      }
    }
  },

  "$defs": {
    "localizedText": {
      "type": "object",
      "description": "Dil kodu -> metin. 'en' zorunlu, diğer diller opsiyonel; eksikse 'en'e düşülür.",
      "required": ["en"],
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 120 }
    },

    "indicatorId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "Kural setinde benzersiz. OHLCV sütun adlarıyla çakışamaz (loader doğrular)."
    },

    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fn"],
      "properties": {
        "id": { "$ref": "#/$defs/indicatorId" },
        "fn": {
          "enum": ["rsi", "ema", "sma", "macd", "bbands", "atr", "adx"],
          "description": "Güvenli fonksiyon whitelist'i. Buranın dışı yok."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "period": { "type": "integer", "minimum": 2, "maximum": 500 },
            "fast": { "type": "integer", "minimum": 2, "maximum": 200 },
            "slow": { "type": "integer", "minimum": 3, "maximum": 500 },
            "signal": { "type": "integer", "minimum": 2, "maximum": 200 },
            "stds": { "type": "number", "minimum": 0.5, "maximum": 5 }
          }
        },
        "output": {
          "enum": ["macd", "signal", "hist", "upper", "middle", "lower"],
          "description": "Çok çıktılı indikatörlerde hangi seri kullanılacak (macd, bbands)."
        }
      }
    },

    "operand": {
      "description": "Sayı sabiti, OHLCV sütunu ya da tanımlı bir indikatör id'si.",
      "anyOf": [
        { "type": "number" },
        { "enum": ["open", "high", "low", "close", "volume"] },
        { "$ref": "#/$defs/indicatorId" }
      ]
    },

    "condition": {
      "description": "Koşul ağacı. Yaprak = karşılaştırma, düğüm = all/any/not.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" },
        "cmp": { "$ref": "#/$defs/comparison" }
      }
    },

    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": { "enum": ["lt", "lte", "gt", "gte", "cross_above", "cross_below"] },
        "left": { "$ref": "#/$defs/operand" },
        "right": { "$ref": "#/$defs/operand" }
      }
    }
  }
}
